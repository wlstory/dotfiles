# Brewfile - Declarative Homebrew dependencies
# Install with: brew bundle install --file=Brewfile
# Generate from system: brew bundle dump --file=Brewfile
# Check status: brew bundle check --file=Brewfile
# Clean up unlisted: brew bundle cleanup --file=Brewfile

# Taps
tap "homebrew/bundle"

